{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trigger.dev Management Batches API",
    "version": "3.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batches",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Batch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trigger.dev/api/v1/batches",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new batch of task runs. Used for large-scale parallel processing where runs can be streamed in incrementally."
        },
        {
          "info": {
            "name": "Retrieve Batch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trigger.dev/api/v1/batches/:batchId",
            "params": [
              {
                "name": "batchId",
                "value": "",
                "type": "path",
                "description": "Batch identifier"
              }
            ]
          },
          "docs": "Get details of a specific batch including status and run count."
        }
      ]
    }
  ],
  "bundled": true
}