          "docs": "Override the concurrency limit for a queue."
        },
        {
          "info": {
            "name": "Reset Queue Concurrency",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trigger.dev/api/v1/queues/:queueName/concurrency/reset",
