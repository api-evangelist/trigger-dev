          "docs": "Promote a specific deployment version to production."
        }
      ]
    },
    {
      "info": {
        "name": "Queues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Queues",
            "type": "http"
          },
          "http": {
            "method": "GET",
